<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><PackageId>$(PackagePrefix).OneSpeech.Cli</PackageId><IsPackable>true</IsPackable><PackAsTool>true</PackAsTool><ToolCommandName>onespeech</ToolCommandName></PropertyGroup>
  <ItemGroup><ProjectReference Include="../OneSpeech/OneSpeech.csproj" /><ProjectReference Include="../OneSpeech.Media/OneSpeech.Media.csproj" /></ItemGroup>
  <Target Name="GenerateBuildVersion" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildVersion.g.cs" Lines="internal static class BuildVersion { internal const string Value = &quot;$(Version)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)BuildVersion.g.cs" /></ItemGroup>
  </Target>
</Project>
